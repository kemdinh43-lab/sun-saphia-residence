{
  "name": "sun-saphia-residence",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply sun-saphia-cms --local",
    "db:remote": "wrangler d1 migrations apply sun-saphia-cms --remote",
    "setup:local": "node scripts/setup-local.mjs",
    "admin:password": "node scripts/password.mjs",
    "check": "node --check server/worker.js && node --check server/content.js && node --check server/auth.js && node --check public/admin/studio.js && node --check public/app.js",
    "test": "node --test tests/*.test.mjs",
    "deploy:check": "wrangler deploy --dry-run --outdir .deploy-check",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
