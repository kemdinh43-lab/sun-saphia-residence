{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sun-saphia-residence",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sun-saphia-cms",
    "database_id": "23f14d39-7644-41b7-af3f-e5ef858f36cb",
    "migrations_dir": "migrations"
  }],
  "vars": { "SITE_ORIGIN": "", "ADMIN_EMAIL": "kemdinh43@gmail.com" },
  "observability": { "enabled": true }
}
